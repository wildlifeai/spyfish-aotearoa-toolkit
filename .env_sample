# Copy this file to .env and replace each placeholder. Never commit .env.

# AWS S3 storage used for source media and pipeline data.
S3_BUCKET=<my-s3-bucket>
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
# The application defaults to eu-central-1 when this is omitted.
AWS_REGION=<aws-region>
# Optional local S3-compatible endpoint, for example Moto or LocalStack.
# AWS_ENDPOINT_URL=http://127.0.0.1:5000

# BIIGLE API credentials. Find an API token at https://biigle.de/settings/tokens
BIIGLE_API_EMAIL=<biigle_email>
BIIGLE_API_TOKEN=<biigle_api_token>

# Panoptes/Zooniverse credentials for publishing exports.
ZOONIVERSE_USER=<zooniverse_username>
ZOONIVERSE_PASSWORD=<zooniverse_password>
