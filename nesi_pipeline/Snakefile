import pandas as pd
import os
from pathlib import Path

# --- Configuration ---
# Snakemake automatically provides `config` dictionary via the --config flag used in ml_runner.py

from spyfish.config import get_required

# The manifest generated by our Python Orchestrator
MANIFEST_PATH = get_required(config, "manifest", "Snakemake config")
MODEL_PATH = get_required(config, "model_path", "Snakemake config")
MODEL_NAME = Path(MODEL_PATH).stem

OUTPUT_DIR = get_required(config, "output_dir", "Snakemake config")
LOG_DIR = get_required(config, "log_dir", "Snakemake config")

# --- Target Definition ---
# Read the target videos we need to process from the manifest CSV
# The CSV has columns: DropID, VideoURL
if os.path.exists(MANIFEST_PATH):
    df = pd.read_csv(MANIFEST_PATH)
    TARGET_DROPS = df["DropID"].tolist()
else:
    TARGET_DROPS = []

rule all:
    input:
        # For now, our final desired output is just the inference CSV for the single video
        expand(f"{OUTPUT_DIR}/{{drop_id}}_{MODEL_NAME}_raw.csv", drop_id=TARGET_DROPS)

rule run_yolo_inference:
    """
    Downloads the specific video (if an HTTP URL is provided),
    runs the Ultralytics YOLO inference, and saves the detections to a CSV.
    """
    input:
        # We don't declare the video as a file input because it's an S3 URL
        # We get the URL from the manifest dynamically
    params:
        video_url=lambda wildcards: df.loc[df['DropID'] == wildcards.drop_id, 'VideoURL'].values[0],
        sampling_start=lambda wildcards: df.loc[df['DropID'] == wildcards.drop_id, 'SamplingStart'].values[0],
        sampling_end=lambda wildcards: df.loc[df['DropID'] == wildcards.drop_id, 'SamplingEnd'].values[0]
    output:
        csv=f"{OUTPUT_DIR}/{{drop_id}}_{MODEL_NAME}_raw.csv"
    log:
        f"{LOG_DIR}/inference/{{drop_id}}.log"
    script:
        "../spyfish/ml/run_inference.py"
